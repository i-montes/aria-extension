{
  "manifest_version": 3,
  "name": "Aria",
  "version": "0.1.0",
  "description": "Aria en tu navegador: observa, abre e interactúa con pestañas sin activación manual.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Aria (sin configuración: funciona automáticamente)"
  },
  "icons": {
    "128": "icon-128.png"
  }
}